 "candidate_claims": [
  "Para buscar en el catálogo de RG, BGE-M3 (MIT) es el candidato más completo: una sola pasada da vectores densos y dispersos y admite documentos largos.",
  "jina-embeddings-v3 no es apto para un producto comercial por su licencia no comercial."
 ],
 "candidate_methods": [
  "Recuperación híbrida: vector denso + disperso (BGE-M3) para encontrar, y reordenador (bge-reranker-v2-m3) para elegir; la cita final sale del crudo con su sha256, nunca del modelo.",
  "Medición antes de adoptar: un conjunto reservado de preguntas sobre leyes mexicanas con respuesta citada, comparando BGE-M3, gte y e5."
 ],
 "candidate_controls": [
  "La señal de un detector de inyección solo agrega información; el contenido externo siempre se trata como dato aunque el detector diga limpio.",
  "Cada modelo adoptado entra con licencia verificada y versión (sha) fija."
 ],
 "candidate_tests": [
  "Describe: una pregunta sobre un artículo de una ley federal debe recuperar ese artículo entre los primeros resultados y citar el PDF por su sha256.",
  "Describe: un texto en español con una instrucción oculta debe marcarse por el detector multilingüe; si no se marca, el contenido igual se trata como dato."
 ],
 "possible_implications_for_zpmnd": [
  "Un índice semántico del catálogo de RG (calculado una vez por versión del corpus) daría a ZPMND búsqueda por significado sobre DOF, leyes y legislación estatal.",
  "Los benchmarks mexicanos podrían servir como evaluación reservada si ZPMND verifica su procedencia y licencia."
 ],
 "affected_existing_concepts": [
  "plano de conocimiento",
  "evaluación reservada",
  "respuesta citada"
 ],
 "hypotheses_generated": [
  "HIPÓTESIS: los títulos y metadatos del catálogo (unos 31 mil registros) se pueden vectorizar en CPU; el texto completo de los crudos probablemente requiere GPU rentada por horas."
 ],
 "limitations": [
  "Solo fichas de los autores; nada medido en español jurídico.",
  "No se descargaron pesos de modelos.",
  "Costos de cómputo no verificados."
 ],
