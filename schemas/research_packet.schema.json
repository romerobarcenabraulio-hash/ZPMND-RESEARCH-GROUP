{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zpmnd-research-group/schemas/research_packet.schema.json",
  "title": "ResearchPacket (RESEARCH GROUP -> ZPMND airlock)",
  "description": "Candidate evidence, never truth. status is always CANDIDATE; there is no field for authority, verification, canon, policy or promotion, and no unknown field is accepted. candidate_* entries are descriptions for ZPMND to evaluate; ZPMND never executes them.",
  "type": "object",
  "additionalProperties": false,
  "required": ["research_id", "request_id", "status", "produced_at", "question", "why_zpmnd_needs_it", "scope", "sources", "artifacts", "findings", "limitations", "researcher_agents"],
  "properties": {
    "research_id": { "type": "string", "pattern": "^RP-[A-Za-z0-9._-]{3,64}$" },
    "request_id": { "$ref": "common.schema.json#/$defs/request_id" },
    "status": { "const": "CANDIDATE" },
    "produced_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "question": { "$ref": "common.schema.json#/$defs/text" },
    "why_zpmnd_needs_it": { "$ref": "common.schema.json#/$defs/text" },
    "scope": { "$ref": "common.schema.json#/$defs/text" },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "secondary"],
      "properties": {
        "primary": { "type": "array", "maxItems": 200, "items": { "$ref": "common.schema.json#/$defs/artifact_id" } },
        "secondary": { "type": "array", "maxItems": 200, "items": { "$ref": "common.schema.json#/$defs/artifact_id" } }
      }
    },
    "artifacts": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "$ref": "source_artifact.schema.json" } },
    "findings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmed", "conflicting", "unknown"],
      "properties": {
        "confirmed": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/finding" } },
        "conflicting": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/finding" } },
        "unknown": { "$ref": "common.schema.json#/$defs/text_list" }
      }
    },
    "candidate_claims": { "$ref": "common.schema.json#/$defs/text_list" },
    "candidate_methods": { "$ref": "common.schema.json#/$defs/text_list" },
    "candidate_controls": { "$ref": "common.schema.json#/$defs/text_list" },
    "candidate_tests": { "$ref": "common.schema.json#/$defs/text_list" },
    "possible_implications_for_zpmnd": { "$ref": "common.schema.json#/$defs/text_list" },
    "affected_existing_concepts": { "$ref": "common.schema.json#/$defs/text_list" },
    "hypotheses_generated": { "$ref": "common.schema.json#/$defs/text_list" },
    "limitations": { "$ref": "common.schema.json#/$defs/text_list", "minItems": 1 },
    "researcher_agents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["agent", "model", "substrate"],
        "properties": {
          "agent": { "$ref": "common.schema.json#/$defs/short_text" },
          "model": { "$ref": "common.schema.json#/$defs/short_text" },
          "substrate": { "$ref": "common.schema.json#/$defs/short_text" }
        }
      }
    }
  },
  "$defs": {
    "finding": {
      "description": "confirmed = stated by the cited sources, NOT verified; verification happens in ZPMND.",
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "artifact_ids"],
      "properties": {
        "claim": { "$ref": "common.schema.json#/$defs/text" },
        "artifact_ids": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "common.schema.json#/$defs/artifact_id" } },
        "quote": { "allOf": [ { "$ref": "common.schema.json#/$defs/text" } ], "maxLength": 300 },
        "locator": { "$ref": "common.schema.json#/$defs/short_text" }
      }
    }
  }
}
