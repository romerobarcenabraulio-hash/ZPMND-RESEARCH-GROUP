{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zpmnd-research-group/schemas/common.schema.json",
  "title": "Shared definitions",
  "$defs": {
    "text": {
      "description": "Visible text only: no C0/C1 control characters except tab and newline, no zero-width or bidi-override characters (hidden instructions).",
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F\\u200B-\\u200F\\u202A-\\u202E\\u2060-\\u2064\\u2066-\\u2069\\uFEFF]*$"
    },
    "short_text": { "allOf": [ { "$ref": "#/$defs/text" } ], "maxLength": 300 },
    "text_list": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/text" } },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "url": { "type": "string", "maxLength": 2000, "pattern": "^https?://[^\\s\\u0000-\\u001F]+$" },
    "request_id": { "type": "string", "pattern": "^RR-[A-Za-z0-9._-]{3,64}$" },
    "artifact_id": { "type": "string", "pattern": "^SA-[A-Za-z0-9._-]{3,64}$" }
  }
}
