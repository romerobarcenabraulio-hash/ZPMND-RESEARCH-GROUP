# Deterministic catalog runner: stdlib fetcher + jsonschema. No model, no agent, no credentials.
# Build context: repository root (see compose.yml). Code is mounted read-only at run time; only /work is writable.
FROM docker.io/library/python:3.12-slim-bookworm@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258
COPY requirements-dev.txt /tmp/requirements-dev.txt
RUN pip install --no-cache-dir --disable-pip-version-check -r /tmp/requirements-dev.txt \
 && useradd --uid 10001 --create-home rg
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/repo HTTPS_PROXY=http://egress:3128 HTTP_PROXY=http://egress:3128
USER rg
WORKDIR /repo
ENTRYPOINT ["python", "-m", "rg.catalog.run"]
