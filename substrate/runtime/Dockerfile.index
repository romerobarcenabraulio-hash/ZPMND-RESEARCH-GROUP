# Semantic index of the catalog with an open Hugging Face model, CPU only. No LLM, no agent, no credentials.
# Build context: repository root. Model weights are downloaded once into /work/hf-cache through the egress proxy.
FROM docker.io/library/python:3.12-slim-bookworm@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258
COPY substrate/runtime/requirements-index.txt /tmp/requirements-index.txt
RUN pip install --no-cache-dir --disable-pip-version-check -r /tmp/requirements-index.txt \
 && useradd --uid 10001 --create-home rg
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/repo HTTPS_PROXY=http://egress:3128 HTTP_PROXY=http://egress:3128 \
    HF_HOME=/work/hf-cache HF_HUB_DISABLE_TELEMETRY=1 TOKENIZERS_PARALLELISM=false
USER rg
WORKDIR /repo
ENTRYPOINT ["python", "-m", "rg.index"]
